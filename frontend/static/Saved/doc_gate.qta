// /// documentation showcase — hover params, autocomplete, function browser
/// - Bellgate prepares |00⟩+|11⟩
/// qbit control - control qubit
/// qbit target - target qubit
gate Bellgate(control, target) {
    H(control)
    CNot(control, target)
}

/// - add two integers
/// int a - first operand
/// int b - second operand
/// return: int - sum
func int add(int a, int b) {
    return a + b;
}

qbit[2] q
Bellgate(q[0], q[1])
Print(f"Entangled: {q}")

int sum = add(3, 5)
Print(f"classical add: {sum}")
