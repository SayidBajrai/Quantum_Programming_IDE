// Quanta Bell state — custom gate, f-strings, simulation
qbit[2] q
bit[2] c

/// - Bellgate prepares an entangled pair
/// qbit a - control qubit
/// qbit b - target qubit
gate Bellgate(a, b) {
    H(a)
    CNot(a, b)
}

Print(f"Before Bell: {q}")
Bellgate(q[0], q[1])
Print(f"After Bell: {q}")

Measure(q, c)
Print(c)
